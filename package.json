{
  "name": "reviewbench",
  "version": "1.0.0",
  "private": true,
  "description": "Open benchmark and judging tools for AI code review systems",
  "type": "module",
  "scripts": {
    "judge": "tsx scripts/eval/eval.ts",
    "harbor:export": "tsx scripts/harbor/export.ts",
    "sync:test-set": "tsx scripts/sync-test-set.ts",
    "check:test-set": "tsx scripts/sync-test-set.ts --check",
    "check:golden": "tsx scripts/validate-golden.ts",
    "typecheck": "tsc --noEmit",
    "test:judge": "node --import tsx --test tests/**/*.test.ts",
    "test": "npm run typecheck && npm run test:judge"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
